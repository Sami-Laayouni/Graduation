# ── Required for production (Vercel KV / Upstash Redis) ─────────────────────
# Create a free KV store at vercel.com/dashboard → Storage → KV
# or at upstash.com, then paste the REST URL + token here.
KV_REST_API_URL=https://your-kv-url.upstash.io
KV_REST_API_TOKEN=your-token-here

# ── Required: protect speaker & admin routes ─────────────────────────────────
# Use a strong random value (e.g. openssl rand -hex 32)
SPEAKER_SECRET=change-me-before-ceremony

# ── Required: your deployed domain (no trailing slash) ───────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ── Optional: default session slug for QR landing ────────────────────────────
NEXT_PUBLIC_DEFAULT_SESSION=demo
